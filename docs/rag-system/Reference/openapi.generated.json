  },
  "components": {
    "schemas": {
      "AskRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question"
          },
          "answer_language": {
            "type": "string",
            "enum": [
              "en",
              "hi",
              "sa"
            ],
            "title": "Answer Language",
            "default": "en"
          },
          "filters": {
            "$ref": "#/components/schemas/Filters"
          },
          "limit": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 6
          },
          "generate": {
            "type": "boolean",
            "title": "Generate",
            "default": true
          },
          "allow_general_knowledge": {
            "type": "boolean",
            "title": "Allow General Knowledge",
            "default": true
          },
          "enhance": {
            "type": "boolean",
            "title": "Enhance",
            "default": true
          },
          "conversation": {
            "items": {
              "$ref": "#/components/schemas/ConversationTurn"
            },
            "type": "array",
            "maxItems": 4,
            "title": "Conversation"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AskRequest"
      },
      "ConversationTurn": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question"
          },
          "answer": {
            "type": "string",
            "maxLength": 2000,
            "title": "Answer",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question"
        ],
        "title": "ConversationTurn"
      },
      "Filters": {
        "properties": {
          "work": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Work"
          },
          "kind": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "base-text",
                  "commentary",
                  "unknown"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Kind"
          },
          "language": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 20
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          },
          "chapter": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 30
              },
              {
                "type": "null"
              }
            ],
            "title": "Chapter"
          }
        },
        "type": "object",
        "title": "Filters"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}